command:
  - sh
  - -c
  - "exec gunicorn --bind 0.0.0.0:${{PORT:-8000}} --workers 1 --threads 8 --timeout 120 app:app"
env:
  - name: COVERPATH_WAREHOUSE_ID
    valueFrom: coverpath-warehouse
  - name: COVERPATH_CATALOG
    value: "{catalog}"
  - name: COVERPATH_SCHEMA
    value: "{schema}"
  - name: COVERPATH_MODEL
    value: "{model}"
